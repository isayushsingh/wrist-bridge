// Copy to Secrets.xcconfig (git-ignored) and fill in.
//   cp Config/Secrets.example.xcconfig Config/Secrets.xcconfig

// Your Apple team id (Xcode > Settings > Accounts). A free Apple ID works for your own watch.
DEVELOPMENT_TEAM = ABCDE12345

// Must be unique to you, e.g. com.ayush.wristbridge
BUNDLE_ID_PREFIX = com.yourname.wristbridge

// Your deployed proxy. Note the $() trick: xcconfig treats // as a comment.
BRIDGE_BASE_URL = https:/$()/your-proxy.vercel.app
BRIDGE_API_KEY = paste-the-same-value-as-BRIDGE_API_KEY-on-vercel

// Which registered app the watch-face complication shows.
BRIDGE_COMPLICATION_APP = demo
