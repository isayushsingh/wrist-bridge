// Build settings shared by the app and the complication extension.
// Personal values (team id, your proxy URL, your key) go in Secrets.xcconfig (git-ignored).
//
// GOTCHA: in .xcconfig files `//` starts a comment, so URLs are written as  https:/$()/host
// The $() expands to nothing, leaving a normal "https://host".

BUNDLE_ID_PREFIX = com.example.wristbridge
BRIDGE_BASE_URL = http:/$()/localhost:3000
BRIDGE_API_KEY =
BRIDGE_COMPLICATION_APP = demo
DEVELOPMENT_TEAM =

#include? "Secrets.xcconfig"
