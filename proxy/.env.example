# Shared secret the watch sends in the `x-bridge-key` header.
# Leave empty in local dev to disable auth. ALWAYS set it on Vercel.
BRIDGE_API_KEY=

# Optional: register extra apps without editing code (JSON array, same shape as watchbridge.config.ts).
# WATCHBRIDGE_APPS=[{"id":"myapp","origin":"https://myapp.vercel.app"}]

# Optional: bearer token forwarded to an app's API when that app sets authTokenEnv: "MYAPP_TOKEN".
# MYAPP_TOKEN=
