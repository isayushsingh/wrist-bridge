flowchart LR
    user(["👤 You"])
    subgraph wrist["⌚ Apple Watch"]
        app["WristBridge app<br/><i>SwiftUI</i>"]
        comp["Complication<br/><i>WidgetKit</i>"]
    end
    subgraph vercel["☁️ Vercel"]
